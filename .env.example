# Address the server listens on. Keep loopback unless a TLS proxy on another
# host must reach it; then use an address only that proxy can reach.
MEMORY_BIND_IP=127.0.0.1
MEMORY_PORT=8765
# Public hostname clients use through that proxy. No scheme or /mcp path here.
MEMORY_HOST=localhost
# Persistent Docker volume; data survives container replacement.
MEMORY_VOLUME_NAME=user-memory-data
# Optional semantic recall through an OpenAI-compatible embeddings endpoint.
# Full endpoint URL; HTTPS required unless it is loopback inside the container.
# Leave empty for keyword-only recall. After changing model or dimensions,
# vectors are rebuilt lazily or with `user-memory reindex`.
USER_MEMORY_EMBED_URL=
USER_MEMORY_EMBED_MODEL=qwen3-embedding:4b
USER_MEMORY_EMBED_DIMENSIONS=
# Prefix for queries only; \n is a newline. Qwen3 example:
# Instruct: Given a question, retrieve the user's matching memory\nQuery:
USER_MEMORY_EMBED_QUERY_INSTRUCTION=
# Optional bearer token for an authenticated endpoint: absolute path of a file
# inside the container (for example on the /data volume). Never put keys in the URL.
USER_MEMORY_EMBED_API_KEY_FILE=
# Plain http to a non-loopback host is refused unless this is 1. Set it only for
# a private network you control, such as the compose sidecar below; it never
# allows sending USER_MEMORY_EMBED_API_KEY_FILE in clear.
USER_MEMORY_EMBED_ALLOW_HTTP=
# Local embedding sidecar (see docs/dev/development.md, "A server built from the checkout"): uncomment all three.
# COMPOSE_PROFILES=embeddings
# USER_MEMORY_EMBED_URL=http://ollama:11434/v1/embeddings
# USER_MEMORY_EMBED_ALLOW_HTTP=1
# Persistent Docker volume for the sidecar's downloaded models.
OLLAMA_VOLUME_NAME=user-memory-ollama-models
