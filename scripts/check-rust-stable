#!/bin/sh
# Refuses a release whose Rust toolchain, the channel rust-toolchain.toml
# names and every build installs, is older than the current stable Rust
# release, unless the comment line just above that channel line starts with
# "# Pinned below stable:" and says why, as for a minimum supported Rust
# version.
#
# Usage: scripts/check-rust-stable
#   RUST_STABLE_CHANNEL  the stable channel to read (default: the official
#                        manifest, static.rust-lang.org); a file:// URL works
#   TOOLCHAIN_FILE       the toolchain file to read (default: the
#                        repository's rust-toolchain.toml)
#
# It reads the network, so the release workflow runs it, not `just check`.
set -eu

channel=${RUST_STABLE_CHANNEL:-https://static.rust-lang.org/dist/channel-rust-stable.toml}
toolchain=${TOOLCHAIN_FILE:-$(dirname "$0")/../rust-toolchain.toml}

fail() {
    printf 'check-rust-stable: %s\n' "$*" >&2
    exit 1
}

pinned=$(sed -n 's/^channel = "\([0-9][0-9.]*\)"$/\1/p' "$toolchain")
[ -n "$pinned" ] || fail "$toolchain names no channel = \"<version>\""
# The manifest's [pkg.rust] section holds version = "1.99.1 (<hash> <date>)".
# awk reads the whole manifest, about 1 MB: stopping at the version would
# leave printf writing to a closed pipe, an error where SIGPIPE is ignored,
# as on GitHub's runners.
manifest=$(curl -fsSL "$channel") || fail "cannot read the stable channel $channel"
stable=$(printf '%s\n' "$manifest" |
    awk '/^\[pkg\.rust\]$/ { section = 1; next }
         /^\[/ { section = 0 }
         section && !found && /^version = "/ { sub(/^version = "/, ""); sub(/ .*/, ""); print; found = 1 }')
[ -n "$stable" ] || fail "$channel names no stable Rust version"

# The newer of the two, comparing each dotted part as a number.
newer=$(printf '%s\n%s\n' "$pinned" "$stable" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
if [ "$pinned" = "$stable" ] || [ "$newer" = "$pinned" ]; then
    echo "Rust $pinned is current (stable is $stable)."
    exit 0
fi

reason=$(awk '/^channel = / { print previous; exit } { previous = $0 }' "$toolchain" |
    sed -n 's/^# Pinned below stable: *\(..*\)$/\1/p')
[ -n "$reason" ] ||
    fail "rust-toolchain.toml pins Rust $pinned, but the current stable is $stable; update its channel, or say why it stays with a comment line just above it: # Pinned below stable: <reason>"
echo "Rust $pinned stays below stable $stable: $reason"
