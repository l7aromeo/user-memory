#!/usr/bin/env bash
set -eu

blocked=0
while IFS= read -r -d '' staged_path; do
  case "$staged_path" in
    docs/plans/*|plans/*|*-plan.md|PLAN.md|*/PLAN.md|plan.md|*/plan.md)
      printf 'Do not commit implementation plans: %s\nWrite plans outside this repository.\n' "$staged_path" >&2
      blocked=1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
exit "$blocked"
